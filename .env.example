# Copy this file to .env and adjust as needed:
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env

# ── Camera ──────────────────────────────────────────────────────────────────
CAMERA_INDEX=0
# Lower resolution + the lightest MediaPipe model are meaningfully easier on
# a weaker CPU, with no real accuracy cost for shoulder/nose landmarks. If
# your PC is comfortably fast, you can raise these.
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
VISION_MODEL_COMPLEXITY=0
# How many consecutive dropped frames to tolerate before reconnecting the
# camera, and how many reconnect attempts to make before giving up.
CAMERA_FAILURE_BACKOFF_THRESHOLD=15
CAMERA_MAX_RECONNECT_ATTEMPTS=5

# ── ESP32 / serial ───────────────────────────────────────────────────────────
SERIAL_PORT=COM5
SERIAL_BAUDRATE=9600

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/posture_monitor.db

# ── Alert thresholds ─────────────────────────────────────────────────────────
DISTRACTION_THRESHOLD_SECONDS=5
BAD_POSTURE_THRESHOLD_SECONDS=15
ALERT_COOLDOWN_SECONDS=5

# ── Calibration (Cognitive Endurance Engine) ────────────────────────────────
# Seconds of "just sit normally" at the start of each session used to build
# this user's personal posture/attention baseline.
CALIBRATION_DURATION_SECONDS=15

# ── Predictive focus-decay nudges (Cognitive Endurance Engine) ─────────────
# Look-back window (seconds) used to detect a declining focus trend, and the
# minimum gap (seconds) between proactive "you're trending down" nudges.
DECAY_TREND_WINDOW_SECONDS=240
DECAY_ALERT_COOLDOWN_SECONDS=300

# ── Sensors: MAX30102 (HRV proxy) + LDR (ambient light) ────────────────────
SENSOR_HR_MIN_BPM=40
SENSOR_HR_MAX_BPM=180
SENSOR_SAVE_INTERVAL_SECONDS=5

# ── IoT: Telegram alert channel ──────────────────────────────────────────────
# Leave both blank to disable -- everything else works exactly the same
# without them. See README for how to create a bot and find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gamification: streaks derived from session history ─────────────────────
GAMIFICATION_GOOD_SESSION_FOCUS_PCT=60
GAMIFICATION_GOOD_SESSION_MIN_MINUTES=5
